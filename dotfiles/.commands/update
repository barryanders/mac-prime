#!/usr/bin/env bash

function __update_sudo() {
  if [[ "${DOTFILES_UNATTENDED:-0}" == "1" ]]; then
    sudo -n "$@"
  else
    sudo "$@"
  fi
}

function __update_root() {
  if [[ "${DOTFILES_UNATTENDED:-0}" == "1" ]]; then
    return 0
  fi

  root
}

function __update_macos() {
  local available_updates

  echo 'Checking macOS updates for restart requirements…'
  available_updates="$(softwareupdate --list 2>&1 || true)"
  echo "$available_updates"

  if echo "$available_updates" | grep -qi 'Action:[[:space:]]*restart'; then
    echo 'Skipping macOS updates because at least one available update requires a restart.'
    echo 'Run Software Update manually when you can afford to lose remote access until local login.'
    return 0
  fi

  __update_sudo softwareupdate -i -a
}

function __update_full_run() {
  section "update dotfiles"
  echo 'Updating dotfiles…'
  ~//dotfiles/install.sh

  section "update hosts"
  echo 'Updating hosts…'
  if [[ -f ~//hosts ]]; then
    __update_sudo install -m 0644 ~//hosts /etc/hosts
  else
    __update_sudo install -m 0644 ~//hosts.example /etc/hosts
  fi

  section "update apps"
  echo 'Updating App Store apps…'
  mas upgrade
  echo 'Updating Homebrew packages…'
  brew update
  brew upgrade
  brew missing || true
  brew cleanup
  (cd ~//apps/ && brew bundle dump --force --describe)

  builtin cd ~
  clean
  section "update macos"
  __update_macos

  # Back up Sublime Text settings
  cp ~/Library/Application\ Support/Sublime\ Text*/Packages/User/Package\ Control.sublime-settings ~//resources/ 2>/dev/null || true
  cp ~/Library/Application\ Support/Sublime\ Text*/Packages/User/Preferences.sublime-settings ~//resources/ 2>/dev/null || true
  section "update settings"
  echo 'Updating Settings…'
  ~//settings
}

function __update_all_run() {
  sfx loop --done=item_acquisition save_station __update_full_run
}

function update() {
  case "$1" in

    # `update apps`
    "apps")
      section "update apps"
      echo 'Updating App Store apps…'
      mas upgrade
      echo 'Updating Homebrew packages…'
      brew update
      brew upgrade
      brew missing || true
      brew cleanup
      (cd ~//apps/ && brew bundle dump --force --describe)
    ;;

    # `update dock`
    "dock") 
      section "update dock"
      echo 'Updating Dock…'
      ~//dock
    ;;

    # `update dotfiles`
    "dotfiles") 
      section "update dotfiles"
      echo 'Updating dotfiles…'
      ~//dotfiles/install.sh
    ;;

    # `update hosts`
    "hosts") 
      section "update hosts"
      echo 'Updating hosts…'
      if [[ -f ~//hosts ]]; then
        __update_sudo install -m 0644 ~//hosts /etc/hosts
      else
        __update_sudo install -m 0644 ~//hosts.example /etc/hosts
      fi
    ;;

      # `update settings`
    "settings")
      section "update settings"
      echo 'Updating Settings…'
      ~//settings
    ;;

    # `update` | Run all of the updates
    "")
      section "update"
      if [[ "${DOTFILES_UNATTENDED:-0}" != "1" ]]; then
        echo 'Requesting root access…'
      fi
      __update_root
      __update_all_run
    ;;

  esac
}

complete -W "all apps dock dotfiles hosts settings" update
