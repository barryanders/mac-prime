#!/usr/bin/env bash

# Metroid Prime Sound Suite
# Enabled/Disabled via DOTFILES_SOUND environment variable

# Shared configuration
SFX_SOUND_DIR="$HOME//resources/sounds"
SFX_PID_FILE="/tmp/sfx_loop.pid"

function sfx() {
    # Internal helper to find sound path regardless of extension
    # Sets the global-ish SFX_LAST_PATH variable
    _get_sound_path() {
        local sound="$1"
        SFX_LAST_PATH=""
        if [[ -f "$SFX_SOUND_DIR/$sound.wav" ]]; then
            SFX_LAST_PATH="$SFX_SOUND_DIR/$sound.wav"
        elif [[ -f "$SFX_SOUND_DIR/$sound.mp3" ]]; then
            SFX_LAST_PATH="$SFX_SOUND_DIR/$sound.mp3"
        fi
    }

    # Internal helper to stop any existing loop
    _sfx_stop() {
        if [[ -f "$SFX_PID_FILE" ]]; then
            local pid
            pid=$(cat "$SFX_PID_FILE")
            kill "$pid" 2>/dev/null || true
            rm "$SFX_PID_FILE"
        fi

        # Clean up orphaned repo sound players when the PID file is stale/missing.
        pkill -f "ffplay .*${SFX_SOUND_DIR}/" 2>/dev/null || true
        pkill -f "afplay .*${SFX_SOUND_DIR}/" 2>/dev/null || true
    }

    # Internal helper to play a sound once
    _sfx_play() {
        local overlap=false
        if [[ "$1" == "--overlap" ]]; then
            overlap=true
            shift
        fi
        [[ "$DOTFILES_SOUND" != "1" ]] && return
        [[ "$overlap" == "false" ]] && _sfx_stop
        _get_sound_path "$1"
        if [[ -n "$SFX_LAST_PATH" ]]; then
            if command -v ffplay >/dev/null 2>&1; then
                # Redirect all output and disown to prevent job control messages
                { ffplay -nodisp -autoexit -loglevel quiet "$SFX_LAST_PATH" >/dev/null 2>&1 & } >/dev/null 2>&1
            elif command -v afplay >/dev/null 2>&1; then
                { afplay "$SFX_LAST_PATH" >/dev/null 2>&1 & } >/dev/null 2>&1
            else
                return 0
            fi
            local pid=$!
            disown $pid 2>/dev/null || true
        fi
    }

    # Internal helper for the standard Affirm + IntoHUD sequence
    _sfx_affirm_hud() {
        _sfx_play "$@" "affirm"
        sleep 1.2
        _sfx_play "$@" "into_hud"
    }

    # Internal helper to loop sound while a command is running
    # Usage: _sfx_loop loop_sound command...
    _sfx_loop() {
        local sound="$1"
        shift
        [[ "$DOTFILES_SOUND" != "1" ]] && { "$@"; return; }
        _sfx_stop

        # Use a background loop that repeatedly starts ffplay until this function ends.
        _get_sound_path "$sound"
        if [[ -n "$SFX_LAST_PATH" ]]; then
            { while true; do
              if command -v ffplay >/dev/null 2>&1; then
                ffplay -nodisp -autoexit -loglevel quiet "$SFX_LAST_PATH" >/dev/null 2>&1
              elif command -v afplay >/dev/null 2>&1; then
                afplay "$SFX_LAST_PATH" >/dev/null 2>&1
              else
                break
              fi
            done; } >/dev/null 2>&1 &
            local pid=$!
            echo "$pid" > "$SFX_PID_FILE"
            disown $pid 2>/dev/null
        fi

        # Run the actual command, then always stop the loop before completion audio.
        "$@"
        local status=$?
        _sfx_stop

        return "$status"
    }

    case "$1" in
        "play")
            shift
            _sfx_play "$@"
            ;;
        "loop")
            shift
            _sfx_loop "$@"
            ;;
        "stop")
            _sfx_stop
            ;;
        *)
            echo "Usage: sfx [play|loop|stop] [sound_name|sound_name command]"
            echo "Example: sfx loop save_station \"bash -lc 'echo test; sleep 3'\""
            ;;
    esac
}

# Tab completion for sfx
_sfx_completion() {
    local cur prev opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    opts="play loop stop"

    if [[ ${COMP_CWORD} -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "${opts}" -- ${cur}) )
        return 0
    fi

    if [[ "$prev" == "play" || "$prev" == "loop" ]]; then
        local sound_dir="$HOME//resources/sounds"
        # Combine all wav and mp3 files, strip extensions, and sort unique
        local sounds=$(ls "$sound_dir"/*.{wav,mp3} 2>/dev/null | xargs -n1 basename | sed -E 's/\.(wav|mp3)$//' | sort -u)
        COMPREPLY=( $(compgen -W "${sounds}" -- ${cur}) )
        return 0
    fi

}

complete -F _sfx_completion sfx
