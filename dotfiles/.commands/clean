#!/usr/bin/env bash

function __clean_sudo() {
  if [[ "${DOTFILES_UNATTENDED:-0}" == "1" ]]; then
    sudo -n "$@"
  else
    sudo "$@"
  fi
}

function __clean_apps_run() {
  __clean_sudo rm -rf /Applications/Google\ Docs.app
  __clean_sudo rm -rf /Applications/Google\ Sheets.app
  __clean_sudo rm -rf /Applications/Google\ Slides.app
  rm -rf ~/Google\ Drive
}

function clean() {
  case "$1" in

    # `clean apps` | Remove unwanted apps that restore themselves after updates
    "apps")
      section "clean apps"
      echo 'Removing unwanted apps…';
      sfx loop save_station __clean_apps_run
    ;;

    # `clean cache` | Remove cache files
    "cache") 
      section "clean cache"
      echo 'Removing local cache…'; 
      rm -rf .cache 
      sfx play affirm
    ;;

    # `clean clipboard` | Empty clipboard
    "clipboard") 
      section "clean clipboard"
      echo 'Emptying clipboard…'; 
      pbcopy < /dev/null 
      sfx play affirm
    ;;

    # `clean dsstore` | Remove Finder metadata files under the user's home directory (excluding Library)
    "dsstore") 
      section "clean dsstore"
      echo 'Removing .DS_Store files in ~ (excluding Library)…'
      sfx loop save_station find "$HOME" -path "$HOME/Library" -prune -o -type f -name ".DS_Store" -print -exec rm -f {} +
    ;;

    # `clean logs` | Remove Apple's system logs to improve shell startup speed
    "logs") 
      section "clean logs"
      echo 'Removing logs…'; 
      sfx loop save_station __clean_sudo rm -rfv /private/var/log/asl/*.asl
    ;;

    # `clean ssh` | Dedupe ssh known hosts
    "ssh")
      section "clean ssh"
      echo 'Deduping SSH known hosts…'
      if [[ -f "${HOME}/.ssh/known_hosts" ]]; then
        tmp=$(mktemp)
        awk '!seen[$0]++' "${HOME}/.ssh/known_hosts" > "$tmp"
        mv "$tmp" "${HOME}/.ssh/known_hosts"
      fi
      sfx play affirm
    ;;

    # `clean` | Run all the clean commands
    "")
      clean apps
      clean cache
      clean clipboard
      clean dsstore
      clean logs
      clean ssh
      sfx play item_acquisition
    ;;

  esac
}

complete -W "apps cache clipboard dsstore logs ssh" clean

function fix() {
  case "$1" in

    # `fix audio` | When audio isn't working
    "audio") 
      __clean_sudo pkill coreaudiod
      sfx play override
      ;;

    # `fix app /Applications/name.app` | When an app tells you "This app is damaged and can't be opened. You should move it to the trash."
    "app") shift 1; xattr -rc "$@" ;;

  esac
}

complete -W "audio app" fix
